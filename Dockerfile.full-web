# full-web 版本 - 基于源码编译的 ZeroTier One + Web UI + 入口脚本
# 结合 full 版本的纯净编译和完整版的功能

FROM debian:12-slim as builder

# 安装构建依赖
RUN set -x \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        curl \
        wget \
        python3 \
        python3-pip \
        pkg-config \
        libssl-dev \
        cargo \
        rustc \
        golang-go \
        clang \
        llvm \
    && rm -rf /var/lib/apt/lists/*

# 下载并编译 ZeroTier One
WORKDIR /src
RUN git clone --depth 1 --branch 1.16.1 https://github.com/zerotier/ZeroTierOne.git \
    && cd ZeroTierOne \
    && make -j$(nproc) ZT_SSO_SUPPORTED=0

# 下载并编译 ztncui（你的排版优化版）
WORKDIR /src
RUN git clone --depth 1 https://github.com/lu920115/zerotier-planet-from-ztncui.git ztncui-src \
    && cd ztncui-src/src \
    && npm install \
    && npm run build \
    || echo "ztncui 构建可能需要手动处理"

# 最终运行镜像
FROM debian:12-slim

# 安装运行时依赖
RUN set -x \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        jq \
        openssl \
        iproute2 \
        iptables \
        procps \
        net-tools \
        supervisor \
        gosu \
        nodejs \
        npm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && rm -rf /usr/share/doc /usr/share/man /usr/share/locale

# 创建用户
RUN groupadd -r zerotier-one && useradd -r -g zerotier-one -d /var/lib/zerotier-one zerotier-one

# 从构建阶段复制 ZeroTier One 二进制
COPY --from=builder /src/ZeroTierOne/zerotier-one /usr/sbin/
RUN ln -sf /usr/sbin/zerotier-one /usr/sbin/zerotier-cli \
    && ln -sf /usr/sbin/zerotier-one /usr/sbin/zerotier-idtool

# 复制 ztncui（如果构建成功）
COPY --from=builder /src/ztncui-src/src /opt/key-networks/ztncui

# 创建必要的目录
RUN mkdir -p /var/lib/zerotier-one \
    /opt/key-networks/ztncui/etc \
    /opt/key-networks/ztncui/etc/tls \
    /opt/key-networks/ztncui/etc/storage \
    /app

# 复制入口脚本和配置文件（从 v1.14.1.2 镜像提取）
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /start_zt1.sh /start_zt1.sh
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /start_ztncui.sh /start_ztncui.sh
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /usr/local/bin/argon2g /usr/local/bin/
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /usr/local/bin/minica /usr/local/bin/
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /usr/local/bin/gfileserv /usr/local/bin/
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /etc/supervisord.conf /etc/supervisord.conf

# 创建 supervisord 配置
RUN echo '[program:ztone]' > /etc/supervisord.conf \
    && echo 'command=/start_zt1.sh' >> /etc/supervisord.conf \
    && echo 'autostart=true' >> /etc/supervisord.conf \
    && echo 'startsecs=10' >> /etc/supervisord.conf \
    && echo 'startretries=3' >> /etc/supervisord.conf \
    && echo 'priority=5' >> /etc/supervisord.conf \
    && echo 'redirect_stderr=true' >> /etc/supervisord.conf \
    && echo 'directory=/tmp' >> /etc/supervisord.conf \
    && echo 'stdout_logfile=/var/log/docker-ztone.log' >> /etc/supervisord.conf \
    && echo '' >> /etc/supervisord.conf \
    && echo '[program:ztncui]' >> /etc/supervisord.conf \
    && echo 'command=/start_ztncui.sh' >> /etc/supervisord.conf \
    && echo 'autostart=true' >> /etc/supervisord.conf \
    && echo 'startsecs=10' >> /etc/supervisord.conf \
    && echo 'startretries=3' >> /etc/supervisord.conf \
    && echo 'priority=10' >> /etc/supervisord.conf \
    && echo 'redirect_stderr=true' >> /etc/supervisord.conf \
    && echo 'directory=/opt/key-networks/ztncui' >> /etc/supervisord.conf \
    && echo 'stdout_logfile=/var/log/docker-ztncui.log' >> /etc/supervisord.conf \
    && echo '' >> /etc/supervisord.conf \
    && echo '[supervisord]' >> /etc/supervisord.conf \
    && echo 'logfile=/var/log/docker-supervisord.log' >> /etc/supervisord.conf \
    && echo 'nodaemon=true' >> /etc/supervisord.conf

# 设置权限
RUN chmod +x /start_zt1.sh /start_ztncui.sh \
    && chown -R zerotier-one:zerotier-one /var/lib/zerotier-one /opt/key-networks/ztncui

# 暴露端口
EXPOSE 9993/udp 9993/tcp 3180/tcp 28000/tcp

# 入口脚本直接使用 supervisord
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

LABEL org.opencontainers.image.title="zerotier-planet" \
      org.opencontainers.image.version="v1.16.1.1-full-web" \
      org.opencontainers.image.description="ZeroTier Planet Server - Full Build with Web UI"
