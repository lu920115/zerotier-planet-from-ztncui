# full-web 版本 - 基于源码编译的 ZeroTier One + Web UI + 入口脚本
# 结合 full 版本的纯净编译和完整版的功能

FROM debian:12-slim as builder

# 安装构建依赖
RUN set -x \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        curl \
        wget \
        python3 \
        python3-pip \
        pkg-config \
        libssl-dev \
        cargo \
        rustc \
        golang-go \
        clang \
        llvm \
    && rm -rf /var/lib/apt/lists/*

# 下载并编译 ZeroTier One（启用 embedded controller 功能）
WORKDIR /src
RUN git clone --depth 1 --branch 1.16.1 https://github.com/zerotier/ZeroTierOne.git \
    && cd ZeroTierOne \
    && make -j$(nproc) ZT_SSO_SUPPORTED=0 ZT_NONFREE=1

# 下载 ztncui 源码
WORKDIR /src
RUN git clone --depth 1 https://github.com/lu920115/zerotier-planet-from-ztncui.git ztncui-src

# 最终运行镜像
FROM debian:12-slim

# 安装运行时依赖（包含 Node.js 和编译工具，用于安装 argon2 等原生模块）
RUN set -x \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        jq \
        openssl \
        iproute2 \
        iptables \
        procps \
        net-tools \
        supervisor \
        gosu \
        nodejs \
        npm \
        build-essential \
        python3 \
        make \
        g++ \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && rm -rf /usr/share/doc /usr/share/man /usr/share/locale

# 创建用户
RUN groupadd -r zerotier-one && useradd -r -g zerotier-one -d /var/lib/zerotier-one zerotier-one

# 从构建阶段复制 ZeroTier One 二进制
COPY --from=builder /src/ZeroTierOne/zerotier-one /usr/sbin/
RUN ln -sf /usr/sbin/zerotier-one /usr/sbin/zerotier-cli \
    && ln -sf /usr/sbin/zerotier-one /usr/sbin/zerotier-idtool

# 复制 ztncui 源码
COPY --from=builder /src/ztncui-src/src /opt/key-networks/ztncui

# 安装 ztncui 的 Node.js 依赖（argon2 需要编译原生模块）
RUN cd /opt/key-networks/ztncui \
    && npm install \
    && npm cache clean --force

# 创建必要的目录
RUN mkdir -p /var/lib/zerotier-one \
    /opt/key-networks/ztncui/etc \
    /opt/key-networks/ztncui/etc/tls \
    /opt/key-networks/ztncui/etc/storage \
    /app

# 复制入口脚本和配置文件（从 v1.14.1.2 镜像提取）
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /start_zt1.sh /start_zt1.sh
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /usr/local/bin/argon2g /usr/local/bin/
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /usr/local/bin/minica /usr/local/bin/
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /usr/local/bin/gfileserv /usr/local/bin/
COPY --from=lu920115/zerotier-planet:v1.14.1.2 /etc/supervisord.conf /etc/supervisord.conf

# 创建 full-web 版本的 ztncui 启动脚本（直接使用 node ./bin/www）
RUN cat > /start_ztncui.sh << 'EOF'
#!/bin/bash
set -e

cd /opt/key-networks/ztncui

if [ -z "$MYADDR" ]; then
    echo "Set Your IP Address to continue."
    echo "If you don't do that, I will automatically detect."
    MYEXTADDR=$(curl --connect-timeout 5 ip.sb || true)
    if [ -z "$MYEXTADDR" ]; then
        MYINTADDR=$(ifconfig eth0 2>/dev/null | grep -Eo 'inet (addr:)?([0-9]*\.){3}[0-9]*' | grep -Eo '([0-9]*\.){3}[0-9]*' | grep -v '127.0.0.1' || true)
        MYADDR=${MYINTADDR}
    else
        MYADDR=${MYEXTADDR}
    fi
    echo "YOUR IP: ${MYADDR}"
fi

MYDOMAIN=${MYDOMAIN:-ztncui.docker.test}
HTTP_PORT=${HTTP_PORT:-3000}
HTTPS_PORT=${HTTPS_PORT:-3443}

while [ ! -f /var/lib/zerotier-one/authtoken.secret ]; do
    echo "ZT1 AuthToken is not found... Wait for ZT1 to start..."
    sleep 2
done
chown zerotier-one:zerotier-one /var/lib/zerotier-one/authtoken.secret
chmod 640 /var/lib/zerotier-one/authtoken.secret

cd /opt/key-networks/ztncui

echo "NODE_ENV=production" > /opt/key-networks/ztncui/.env
echo "MYADDR=$MYADDR" >> /opt/key-networks/ztncui/.env
echo "HTTP_PORT=$HTTP_PORT" >> /opt/key-networks/ztncui/.env
if [ ! -z "$HTTP_ALL_INTERFACES" ]; then
  echo "HTTP_ALL_INTERFACES=$HTTP_ALL_INTERFACES" >> /opt/key-networks/ztncui/.env
else
  [ ! -z "$HTTPS_PORT" ] && echo "HTTPS_PORT=$HTTPS_PORT" >> /opt/key-networks/ztncui/.env
fi

echo "ZTNCUI ENV CONFIGURATION: "
cat /opt/key-networks/ztncui/.env

mkdir -p /opt/key-networks/ztncui/etc/storage
mkdir -p /opt/key-networks/ztncui/etc/tls
mkdir -p /opt/key-networks/ztncui/etc/myfs

if [ ! -f /opt/key-networks/ztncui/etc/passwd ]; then
    echo "Default Password File Not Exists... Generating with default password 'admin'..."
    mkdir -p /opt/key-networks/ztncui/etc
    # 使用 Node.js 生成 argon2 hash（密码固定为 admin，pass_set 为 false 强制首次修改）
    node -e "
const argon2 = require('argon2');
(async () => {
  const hash = await argon2.hash('admin');
  const passwd = { admin: { name: 'admin', pass_set: false, hash: hash } };
  require('fs').writeFileSync('/opt/key-networks/ztncui/etc/passwd', JSON.stringify(passwd));
  console.log('Default password file created. Username: admin, Password: admin');
})();
"
    cd ../
fi

if [ ! -f /opt/key-networks/ztncui/etc/tls/fullchain.pem ] || [ ! -f /opt/key-networks/ztncui/etc/tls/privkey.pem ]; then
    echo "Cannot detect TLS Certs, Generating..."
    cd /opt/key-networks/ztncui/etc/tls
    /usr/local/bin/minica -domains "$MYDOMAIN"
    cp -f "$MYDOMAIN/cert.pem" fullchain.pem
    cp -f "$MYDOMAIN/key.pem" privkey.pem
    cd ../../
fi

chown -R zerotier-one:zerotier-one /opt/key-networks/ztncui

unset ZTNCUI_PASSWD
cd /opt/key-networks/ztncui && exec gosu zerotier-one:zerotier-one node ./bin/www
EOF

# 创建 planet 文件服务启动脚本
RUN cat > /start_ztplaserv.sh << 'EOF'
#!/bin/bash
set -e

# 等待 zerotier-one 生成 planet 文件
while [ ! -f /var/lib/zerotier-one/planet ]; do
    echo "Planet file is not found... Wait for ZT1 to start..."
    sleep 2
done

# 创建 myfs 目录并复制 planet 文件
mkdir -p /opt/key-networks/ztncui/etc/myfs
cp /var/lib/zerotier-one/planet /opt/key-networks/ztncui/etc/myfs/planet

# 使用 Python 启动简单的 HTTP 服务器提供 planet 文件下载
cd /opt/key-networks/ztncui/etc/myfs
exec python3 -m http.server 3180
EOF

# 创建 supervisord 配置（包含 ztplaserv 服务）
RUN cat > /etc/supervisord.conf << 'EOF'
[program:ztone]
command=/start_zt1.sh
autostart=true
startsecs=10
startretries=3
priority=5
redirect_stderr=true
directory=/tmp
stdout_logfile=/var/log/docker-ztone.log

[program:ztncui]
command=/start_ztncui.sh
autostart=true
startsecs=10
startretries=3
priority=10
redirect_stderr=true
directory=/opt/key-networks/ztncui
stdout_logfile=/var/log/docker-ztncui.log

[program:ztplaserv]
command=/start_ztplaserv.sh
autostart=true
startsecs=10
startretries=3
priority=15
redirect_stderr=true
stdout_logfile=/var/log/docker-ztplaserv.log

[supervisord]
logfile=/var/log/docker-supervisord.log
nodaemon=true
EOF

# 设置权限
RUN chmod +x /start_zt1.sh /start_ztncui.sh /start_ztplaserv.sh \
    && chown -R zerotier-one:zerotier-one /var/lib/zerotier-one /opt/key-networks/ztncui

# 暴露端口
EXPOSE 9993/udp 9993/tcp 3180/tcp 28000/tcp

# 入口脚本直接使用 supervisord
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

LABEL org.opencontainers.image.title="zerotier-planet" \
      org.opencontainers.image.version="v1.16.1.1-full-web" \
      org.opencontainers.image.description="ZeroTier Planet Server - Full Build with Web UI"
