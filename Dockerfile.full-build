# 完整构建版本 - 从 Debian 基础镜像开始构建
# 此文件用于参考和测试完整构建流程

FROM debian:12-slim as builder

# 安装构建依赖
RUN set -x \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        curl \
        wget \
        python3 \
        python3-pip \
        pkg-config \
        libssl-dev \
        cargo \
        rustc \
        golang-go \
        clang \
        llvm \
    && rm -rf /var/lib/apt/lists/*

# 下载并编译 ZeroTier One
# 注意：编译过程可能需要很长时间，且可能遇到网络/依赖问题
WORKDIR /src
RUN git clone --depth 1 --branch 1.16.1 https://github.com/zerotier/ZeroTierOne.git \
    && cd ZeroTierOne \
    && make -j$(nproc) ZT_SSO_SUPPORTED=0 \
    || echo "编译可能失败，需要手动排查"

# 最终运行镜像
FROM debian:12-slim

# 安装运行时依赖
RUN set -x \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        jq \
        openssl \
        iproute2 \
        iptables \
        procps \
        net-tools \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# 从构建阶段复制 ZeroTier One 二进制
COPY --from=builder /src/ZeroTierOne/zerotier-one /usr/sbin/
RUN ln -sf /usr/sbin/zerotier-one /usr/sbin/zerotier-cli \
    && ln -sf /usr/sbin/zerotier-one /usr/sbin/zerotier-idtool

# 安装 ztncui（Node.js 应用）
# 这里需要添加 ztncui 的安装步骤

# 创建必要的目录
RUN mkdir -p /var/lib/zerotier-one /app

# 暴露端口
EXPOSE 9993/udp 9993/tcp 3180/tcp

# 入口脚本（可选，如果不需要可以注释掉）
# COPY patch/entrypoint.sh /app/
# RUN chmod +x /app/entrypoint.sh

CMD ["/bin/bash"]

LABEL org.opencontainers.image.title="zerotier-planet" \
      org.opencontainers.image.version="v1.16.1.1-full" \
      org.opencontainers.image.description="ZeroTier Planet Server - Full Build"
